---
import '../styles/global.css';
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <title>{title}</title>
    <!-- 앱 웹뷰(?app=1)는 자체 AppBar가 있어 제목·하단 이동을 숨긴다. 그리기 전에 붙여야 깜빡이지 않음 -->
    <script is:inline>if (/[?&]app=1/.test(location.search)) document.documentElement.classList.add('app');</script>
  </head>
  <body>
    <div class="wrap">
      <main class="doc"><slot /></main>
    </div>
    <footer class="foot">© 미핑(MiPing) · 모두에게 공평한 중간지점</footer>
    <script>
      // 스크롤 시 섹션이 부드럽게 나타나도록 .in 클래스만 붙인다 (모션 줄이기 설정이면 CSS가 무시)
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
        { rootMargin: '0px 0px -8% 0px' }
      );
      document.querySelectorAll('.doc > h2, .links li').forEach((el) => {
        el.classList.add('rv');
        io.observe(el);
      });
    </script>
  </body>
</html>
